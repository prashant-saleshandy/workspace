# Copy this file to ~/.pi/agent/.env on each machine.
# Never commit the real ~/.pi/agent/.env file.
#
# Used by: extensions/firecrawl-search.ts
# Enables model tools: search, scrape
FIRECRAWL_API_KEY=

# Notes:
# - Pi provider auth is usually stored by `pi /login` in auth.json, not here.
# - If you prefer API-key auth for providers, keep those exports in your shell profile
#   or add them here only if your local workflow loads ~/.pi/agent/.env for Pi startup.
#   Examples you may need manually:
#   ANTHROPIC_API_KEY=
#   OPENAI_API_KEY=
#   GOOGLE_GENERATIVE_AI_API_KEY=
